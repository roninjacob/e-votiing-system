# Local testing: shows the OTP on screen when SMTP is not configured. Set to 0 in production.
EVS_DEV_MODE=1
EVS_TIMEZONE=Asia/Manila
# Real email delivery (Gmail: use an App Password)
EVS_SMTP_HOST=
EVS_SMTP_PORT=587
EVS_SMTP_USER=
EVS_SMTP_PASSWORD=
EVS_SMTP_FROM=
# MySQL database imported from database/mysql_schema.sql (XAMPP defaults shown)
EVS_DB_HOST=127.0.0.1
EVS_DB_PORT=3306
EVS_DB_NAME=evs_module2
EVS_DB_USER=root
EVS_DB_PASSWORD=
