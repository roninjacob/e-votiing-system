# Local testing: shows the OTP on screen when SMTP is not configured. Set to 0 in production.
EVS_DEV_MODE=1
EVS_TIMEZONE=Asia/Manila
# Real email delivery (Gmail: use an App Password)
EVS_SMTP_HOST=
EVS_SMTP_PORT=587
EVS_SMTP_USER=
EVS_SMTP_PASSWORD=
EVS_SMTP_FROM=
# Optional: path to a SQLite file (default data/e_voting_system.sqlite)
# EVS_DB_PATH=
